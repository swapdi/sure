<%# locals: (options:, aria_label:) %>
<%# Dropdown to pick the active line of a multi-series chart. Scales to many
    lines where a tab row would overflow. options: [{ key:, label:, color:, section: }] %>
<% first = options.first %>
<%= render DS::Popover.new(variant: :button, placement: "bottom-start", offset: 8, max_width: "20rem") do |popover| %>
  <% popover.with_button(
       class: "inline-flex items-center gap-2 bg-container border border-secondary font-medium rounded-lg pl-3 pr-2 py-2 text-sm cursor-pointer text-primary hover:bg-container-inset-hover focus:outline-hidden focus:ring-0 max-w-full",
       aria: { label: aria_label }
     ) do %>
    <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background: <%= first[:color] || "var(--color-gray-400)" %>"
          data-multi-series-chart-target="lineSwatch"></span>
    <span class="truncate" data-multi-series-chart-target="lineLabel"><%= first[:label] %></span>
    <%= icon("chevron-down", size: "sm") %>
  <% end %>

  <% popover.with_custom_content do %>
    <div class="px-1 max-h-80 overflow-y-auto">
      <% options.group_by { |o| o[:section] }.each do |section, section_options| %>
        <% if section.present? %>
          <p class="px-2 pt-2 pb-1 text-xs font-medium uppercase text-secondary"><%= section %></p>
        <% end %>
        <% section_options.each do |option| %>
          <button type="button"
                  class="flex items-center gap-2 p-2 rounded-md w-full text-left focus-ring hover:bg-container-hover"
                  data-multi-series-chart-target="lineButton"
                  data-multi-series-chart-line-param="<%= option[:key] %>"
                  data-action="multi-series-chart#selectLine DS--popover#close">
            <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background: <%= option[:color] || "var(--color-gray-400)" %>"></span>
            <span class="flex-1 truncate text-sm text-primary"><%= option[:label] %></span>
            <span class="shrink-0 invisible" data-check><%= icon("check", size: "sm") %></span>
          </button>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
